[Unit]
Description=Polymarket 24/7 Cloud Trading Bot Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/polymarket
EnvironmentFile=/root/polymarket/.env
ExecStart=/usr/bin/python3 /root/polymarket/run.py
Restart=always
RestartSec=10
StandardOutput=append:/root/polymarket/logs/systemd_stdout.log
StandardError=append:/root/polymarket/logs/systemd_stderr.log

[Install]
WantedBy=multi-user.target
