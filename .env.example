# Polymarket Cloud 24/7 Trading Bot Configuration
# ----------------------------------------------------

# TRADING MODE
# Set to 'true' for paper-trading / dry-run (simulation without real funds).
# Set to 'false' ONLY when you are ready to trade with real USDC.
DRY_RUN=true

# POLYGON WALLET CREDENTIALS
# Your Polygon wallet private key (starts with 0x... or 64 hex characters)
# RECOMMENDATION: Use a dedicated trading wallet, NOT your main savings wallet.
POLYGON_PRIVATE_KEY=your_polygon_wallet_private_key_here

# SIGNATURE TYPE
# 0 = Standard EOA (MetaMask, Rabby, private key wallet)
# 1 = Polymarket Proxy Wallet (Magic Link / Email login)
# 2 = Gnosis Safe / Smart Contract wallet
SIGNATURE_TYPE=0

# POLYGON RPC (Default public RPC; use Alchemy/Infura for high performance if desired)
POLYGON_RPC_URL=https://polygon-rpc.com

# POLYMARKET HOST (Production CLOB)
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
CHAIN_ID=137

# RISK LIMITS (Safety guardrails)
MAX_ORDER_SIZE_USD=75.0
MAX_TOTAL_EXPOSURE_USD=850.0
MAX_SLIPPAGE_PERCENT=2.0
MIN_PROFIT_SPREAD=0.015

# DAILY PROFIT GOAL: 0.0 = UNLIMITED (Max Daily Gains)
DAILY_PROFIT_TARGET_USD=0.0
LOOP_INTERVAL_SECONDS=5

# 100% FREE CLOUD HOSTING KEEP-ALIVE SERVER (For Koyeb / Render)
ENABLE_HEALTH_SERVER=true
PORT=8080

# MONITORING & LOOP FREQUENCY
# Seconds between checking markets and rules
LOOP_INTERVAL_SECONDS=10

# REAL-TIME NOTIFICATIONS (Optional - receive alerts on your phone 24/7)
# Telegram Bot Token & Chat ID (leave empty if not using)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook URL (leave empty if not using)
DISCORD_WEBHOOK_URL=
